<?xml version="1.0"?>
<robot name="rover">

  <!-- Base: 1.5m long x 1.0m wide x 0.4m tall, mass 50 kg -->
  <!-- Box inertia: ixx = m/12*(h^2+d^2), iyy = m/12*(w^2+d^2), izz = m/12*(w^2+h^2) -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="1.5 1.0 0.4"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 0.8 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="1.5 1.0 0.4"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="50.0"/>
      <inertia ixx="4.833" ixy="0.0" ixz="0.0"
               iyy="3.208" iyz="0.0"
               izz="2.708"/>
    </inertial>
  </link>

  <!-- Sensor frames (fixed; no physics) -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
  </joint>

  <link name="zed_link"/>
  <joint name="zed_joint" type="fixed">
    <parent link="base_link"/>
    <child link="zed_link"/>
    <origin xyz="0.75 0 0.2" rpy="0 0 0"/>
  </joint>

  <!-- ===== LEFT SIDE (y = +0.6) ===== -->
  <!-- Wheel: cylinder r=0.2, length=0.15, mass=2 kg -->
  <!-- Cylinder about own Z (axis): ixx=iyy = m*(3r^2+h^2)/12, izz = m*r^2/2 -->

  <link name="left_front_wheel">
    <visual>
      <geometry>
        <cylinder length="0.15" radius="0.2"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.15" radius="0.2"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.02375" ixy="0.0" ixz="0.0"
               iyy="0.02375" iyz="0.0"
               izz="0.04"/>
    </inertial>
  </link>
  <joint name="left_front_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_front_wheel"/>
    <origin xyz="0.55 0.6 -0.2" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="left_middle_wheel">
    <visual>
      <geometry>
        <cylinder length="0.15" radius="0.2"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.15" radius="0.2"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.02375" ixy="0.0" ixz="0.0"
               iyy="0.02375" iyz="0.0"
               izz="0.04"/>
    </inertial>
  </link>
  <joint name="left_middle_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_middle_wheel"/>
    <origin xyz="0.0 0.6 -0.2" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="left_rear_wheel">
    <visual>
      <geometry>
        <cylinder length="0.15" radius="0.2"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.15" radius="0.2"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.02375" ixy="0.0" ixz="0.0"
               iyy="0.02375" iyz="0.0"
               izz="0.04"/>
    </inertial>
  </link>
  <joint name="left_rear_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_rear_wheel"/>
    <origin xyz="-0.55 0.6 -0.2" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- ===== RIGHT SIDE (y = -0.6) ===== -->

  <link name="right_front_wheel">
    <visual>
      <geometry>
        <cylinder length="0.15" radius="0.2"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.15" radius="0.2"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.02375" ixy="0.0" ixz="0.0"
               iyy="0.02375" iyz="0.0"
               izz="0.04"/>
    </inertial>
  </link>
  <joint name="right_front_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_front_wheel"/>
    <origin xyz="0.55 -0.6 -0.2" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="right_middle_wheel">
    <visual>
      <geometry>
        <cylinder length="0.15" radius="0.2"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.15" radius="0.2"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.02375" ixy="0.0" ixz="0.0"
               iyy="0.02375" iyz="0.0"
               izz="0.04"/>
    </inertial>
  </link>
  <joint name="right_middle_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_middle_wheel"/>
    <origin xyz="0.0 -0.6 -0.2" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="right_rear_wheel">
    <visual>
      <geometry>
        <cylinder length="0.15" radius="0.2"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.15" radius="0.2"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.02375" ixy="0.0" ixz="0.0"
               iyy="0.02375" iyz="0.0"
               izz="0.04"/>
    </inertial>
  </link>
  <joint name="right_rear_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_rear_wheel"/>
    <origin xyz="-0.55 -0.6 -0.2" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- ===== Gazebo surface friction (wheels) ===== -->
  <gazebo reference="left_front_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>
  <gazebo reference="left_middle_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>
  <gazebo reference="left_rear_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>
  <gazebo reference="right_front_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>
  <gazebo reference="right_middle_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>
  <gazebo reference="right_rear_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>

  <!-- Gazebo: skid-steer via diff_drive (left side vs right side) -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>

      <update_rate>50</update_rate>

      <!-- 3 left + 3 right = 6 driven wheels (matches real Yellowjacket setup) -->
      <num_wheel_pairs>3</num_wheel_pairs>

      <!-- Order: front, middle, rear -->
      <left_joint>left_front_wheel_joint</left_joint>
      <right_joint>right_front_wheel_joint</right_joint>
      <left_joint>left_middle_wheel_joint</left_joint>
      <right_joint>right_middle_wheel_joint</right_joint>
      <left_joint>left_rear_wheel_joint</left_joint>
      <right_joint>right_rear_wheel_joint</right_joint>

      <!-- One separation/diameter per pair (y = ±0.6 → 1.2 m; radius 0.2 → diameter 0.4) -->
      <wheel_separation>1.2</wheel_separation>
      <wheel_separation>1.2</wheel_separation>
      <wheel_separation>1.2</wheel_separation>
      <wheel_diameter>0.4</wheel_diameter>
      <wheel_diameter>0.4</wheel_diameter>
      <wheel_diameter>0.4</wheel_diameter>

      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>5.0</max_wheel_acceleration>

      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>

      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
  </gazebo>

</robot>
